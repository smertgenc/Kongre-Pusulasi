# Göreli yollar proje klasörüne göre çözülür.
KONGRE_DB_PATH=data/kongre.db
KONGRE_PORT=8765
# AI bağlantısı ekranından da kaydedilebilir. Gerçek anahtarları Git'e eklemeyin.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AIMLAPI_API_KEY=
AIMLAPI_MODEL=openai/gpt-5-mini-2025-08-07

# Optional web research services; these do not replace the analysis model.
SEARCH_PROVIDER=jina
JINA_API_KEY=
TAVILY_API_KEY=
